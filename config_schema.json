{
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "title": "Enabled",
      "default": true
    },
    "use_24_hour": {
      "type": "boolean",
      "title": "24-hour clock",
      "default": true
    },
    "show_seconds": {
      "type": "boolean",
      "title": "Display seconds instead of date",
      "description": "When enabled, the display becomes a cohesive HH:MM:SS flip clock and the date section is hidden.",
      "default": false
    },
    "date_uppercase": {
      "type": "boolean",
      "title": "Uppercase date",
      "default": true
    },
    "date_color": {
      "type": "array",
      "title": "Date colour",
      "description": "Colour for the weekday and day/month text.",
      "x-widget": "color-picker",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 255
      },
      "minItems": 3,
      "maxItems": 3,
      "default": [235, 235, 235]
    },
    "animation_ms": {
      "type": "integer",
      "title": "Flip duration (ms)",
      "default": 220,
      "minimum": 80,
      "maximum": 900
    },
    "animation_frames": {
      "type": "integer",
      "title": "Animation frames",
      "default": 4,
      "minimum": 2,
      "maximum": 10
    },
    "display_duration": {
      "type": "number",
      "title": "Display duration (seconds)",
      "default": 60,
      "minimum": 5,
      "maximum": 3600
    }
  },
  "required": ["enabled"],
  "additionalProperties": false
}
